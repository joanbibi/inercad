{
  "name": "inercad",
  "version": "1.0.0",
  "description": "InerCAD: calculadora interactiva de propiedades geométricas y momentos de inercia de secciones planas",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node serve.js 5173",
    "test": "node tests/engine.test.js && node tests/util.test.js",
    "build": "node build.js",
    "desktop": "electron .",
    "desktop:smoke": "electron . --smoke-test",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir --publish never",
    "brand": "electron tools/make-brand.js",
    "fonts": "node tools/fonts.js",
    "screenshots": "electron tools/make-screenshots.js",
    "site": "node tools/build-site.js",
    "site:web": "node tools/build-site.js --no-installers"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.js",
  "author": "joanbibi",
  "build": {
    "appId": "com.inercad.app",
    "productName": "InerCAD",
    "copyright": "© 2026 InerCAD",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "fonts/**/*",
      "assets/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "inercad",
        "name": "Proyecto InerCAD",
        "description": "Proyecto de InerCAD",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InerCAD",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "artifactName": "InerCAD-Setup-${version}.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "menuCategory": false
    },
    "portable": {
      "artifactName": "InerCAD-${version}-portable.exe"
    },
    "compression": "maximum",
    "electronLanguages": [
      "es",
      "en-US"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joanbibi/inercad.git"
  },
  "homepage": "https://inercad.es/",
  "bugs": {
    "url": "https://github.com/joanbibi/inercad/issues"
  }
}
